# .dockerignore - Exclude files from Docker build context
# This reduces build time and image size significantly

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store

# Next.js
.next
out
build
dist
.vercel
.swc

# Environment variables (NEVER copy to Docker image)
# `.env.*` is the load-bearing line: the enumerated names below missed
# `.env.production` / `.env.staging`, which matter now that the `seeder` stage
# does `COPY . .` and is a runnable image rather than an intermediate one.
.env
.env.*
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep .env.example for reference — must stay after the .env.* rule
!.env.example

# Testing
coverage
.nyc_output
*.lcov
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Git
.git
.gitignore
.gitattributes
.github

# Documentation
README.md
*.md
!CLAUDE.md
docs
.instructions

# IDE & Editor
.vscode
.idea
*.swp
*.swo
*.swn
.DS_Store
*.sublime-project
*.sublime-workspace

# Logs (root-level only - don't ignore app/admin/logs etc.)
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma
# Note: migration SQL is NOT excluded. It lives at
# prisma/migrations/<timestamp>_<name>/migration.sql, and the `migrator` stage
# needs it. (A `prisma/migrations/*.sql` rule used to sit here; `*` does not
# cross `/`, so it matched nothing — but it read as though migrations were
# excluded, which is worth not implying.)
prisma/dev.db
prisma/dev.db-journal
*.db
*.db-journal

# Docker (don't copy Docker files into Docker)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Temporary files
tmp
temp
*.tmp
*.temp
.cache

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Claude Code
.claude
