# Non-secret local development settings for THIS app.
#
# Unlike .env.local (ignored, holds secrets), this file is committed: it is how
# an app pins the port it binds so every clone agrees and `npm run dev` needs no
# arguments. Read by scripts/dev-server.mjs — see
# .context/environment/services-env.md#port
#
# Secrets belong in .env.local. Never add one here.

# Sunrise itself. Forks: change this to your own port.
PORT=3010
